{
  "name": "@sync8/email-rte-angular",
  "version": "0.1.0",
  "description": "Angular component (with forms support) for @sync8/email-rte: an inline rich text editor producing email-safe HTML for Outlook and Gmail.",
  "license": "BSD-3-Clause",
  "author": "sync8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devops-sync8/email-rte.git",
    "directory": "packages/rte-angular"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "test": "vite build --config test/vite.config.mjs && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@sync8/email-rte": "^0.1.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/core": ">=20.0.0 <23.0.0",
    "@angular/forms": ">=20.0.0 <23.0.0"
  },
  "devDependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "ng-packagr": "~20.3.0",
    "rxjs": "^7.8.0",
    "typescript": "~5.9.0",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
