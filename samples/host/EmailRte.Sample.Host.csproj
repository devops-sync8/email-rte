<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EmailRte.Sample.Host</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\dotnet\src\Sync8.EmailRte\Sync8.EmailRte.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE;..\..\THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Build the editor demo on publish and ship it as compose-app/, so the output is one deployable. -->
  <Target Name="BuildComposeApp" BeforeTargets="ComputeFilesToPublish" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec Command="npm run build -w @sync8/email-rte" WorkingDirectory="../../" />
    <Exec Command="npm run build -w email-rte-demo" WorkingDirectory="../../" />
    <ItemGroup>
      <ComposeFiles Include="../rte-demo/dist/**" />
      <ResolvedFileToPublish Include="@(ComposeFiles->'%(FullPath)')">
        <RelativePath>compose-app/%(ComposeFiles.RecursiveDir)%(ComposeFiles.Filename)%(ComposeFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
